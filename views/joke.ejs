<!DOCTYPE html>
<html>
<head>
  <title>Joke App</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <a href="/">← Back to Home</a>
  <h1>Get a Joke!</h1>

  <form action="/joke" method="POST">
    <input type="text" name="name" placeholder="Enter your name" required>
    <button type="submit">Get Joke</button>
  </form>

  <% if (joke) { %>
    <h3>Hey <%= name %>! Here's your joke:</h3>
    <p><em><%= reason %></em></p>

    <% if (joke.type === "single") { %>
      <p><%= joke.joke %></p>
    <% } else { %>
      <p><%= joke.setup %></p>
      <p><strong><%= joke.delivery %></strong></p>
    <% } %>
  <% } %>

</body>
</html>